rules_version = '2';

/* Reglas de Firestore para Mis Apps.

   Todo cuelga del usuario que lo creó:

       usuarios/{uid}                      → perfil y ajustes
       usuarios/{uid}/{coleccion}/{id}     → un registro por documento

   Cada persona solo llega a lo que hay bajo su propio UID. Nadie puede leer ni
   escribir en la carpeta de otro, ni aunque conozca su identificador, ni aunque
   modifique la aplicación: esto se comprueba en el servidor, no en el móvil.

   Se pegan en: consola de Firebase → Firestore Database → Reglas → Publicar. */

service cloud.firestore {
  match /databases/{database}/documents {

    function esSuyo(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // El documento del usuario: correo, perfil y ajustes.
    match /usuarios/{uid} {
      allow read, write: if esSuyo(uid);
    }

    // Sus registros. La lista de colecciones es cerrada a propósito: si algún
    // día se añade una nueva a la app, hay que añadirla también aquí.
    match /usuarios/{uid}/{coleccion}/{id} {
      allow read, write: if esSuyo(uid)
                         && coleccion in ['pesos', 'entrenos', 'comidas',
                                          'gastos', 'fijos', 'categorias'];
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
