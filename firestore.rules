rules_version = '2';

/* Reglas de Firestore para Mis Apps.

   Cada persona solo puede leer y escribir su propio documento. Nadie más
   puede ver nada, ni aunque conozca el identificador.

   Se pegan en: consola de Firebase → Firestore Database → Reglas → Publicar. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid}/apps/{app} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && app in ['gastos', 'salud'];
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
